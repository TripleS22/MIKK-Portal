# ---------------------------------------------------------------------
# DUA KONEKSI DATABASE, BUKAN SATU. Lihat README bagian yang sama.
#
# DATABASE_URL      dipakai HANYA oleh `npm run migrate` / `npm run seed`.
#                   Butuh privilese tinggi (CREATE TABLE, EXTENSION, ROLE).
#                   Di Supabase: connection string dari Project Settings.
#
# APP_DATABASE_URL  dipakai SERVER saat runtime, lewat peran mikk_app
#                   yang dibuat migrate.js (05_app_role.sql). Peran ini
#                   BUKAN superuser, sehingga RLS benar-benar berlaku.
#                   Kalau APP_DATABASE_URL tidak diset, server menolak
#                   menyala -- lihat server/lib/db.js untuk alasannya.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:mikkdev@localhost:5544/mikk_portal
APP_DATABASE_URL=postgresql://mikk_app:ganti_ini_sebelum_produksi@localhost:5544/mikk_portal

# Wajib diganti — ini menandatangani token sesi.
JWT_SECRET=ganti-dengan-string-acak-panjang-sebelum-rilis

PORT=4000
NODE_ENV=development
