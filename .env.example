# ---------------------------------------------------------------------
# DUA KONEKSI DATABASE, BUKAN SATU. Lihat README bagian yang sama.
#
# DATABASE_URL      dipakai HANYA oleh `npm run migrate` / `npm run seed`.
#                   Butuh privilese tinggi (CREATE TABLE, EXTENSION, ROLE).
#                   Di Supabase: connection string "Direct connection"
#                   dari Project Settings > Connect.
#
# APP_DATABASE_URL  dipakai SERVER saat runtime, lewat peran mikk_app
#                   yang dibuat migrate.js (05_app_role.sql). Peran ini
#                   BUKAN superuser, sehingga RLS benar-benar berlaku.
#                   Kalau APP_DATABASE_URL tidak diset, server menolak
#                   menyala -- lihat server/lib/db.js untuk alasannya.
#
# Ke Supabase: tambahkan "?uselibpqcompat=true&sslmode=require" di akhir
# connection string-nya (perlu SSL, dan sertifikatnya tidak divalidasi
# ketat lewat opsi ini -- setara "sslmode=require" di psql, BUKAN
# "verify-full"; sudah diuji langsung, bukan tebakan).
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:mikkdev@localhost:5544/mikk_portal
APP_DATABASE_URL=postgresql://mikk_app:ganti_ini_sebelum_produksi@localhost:5544/mikk_portal

# ---------------------------------------------------------------------
# SUPABASE AUTH -- menggantikan JWT kustom + local_auth (lihat
# server/lib/supabase-auth.js). Ketiganya dari Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY WAJIB rahasia -- jangan pernah dikirim ke
# frontend atau dicatat ke log; hanya dipakai server untuk Admin API
# (buat akun, ubah kata sandi).
# ---------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=ganti-dengan-anon-key-project-anda
SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-service-role-key-project-anda

# Menandatangani link pratinjau dokumen berumur pendek (Google Docs
# Viewer / MS Office Online, lihat server/routes/documents.routes.js).
# Wajib diganti -- string acak panjang, sama seperti JWT_SECRET dulu.
DOCUMENT_LINK_SECRET=ganti-dengan-string-acak-panjang-sebelum-rilis

PORT=4000
NODE_ENV=development
